@using Umbraco.Cms.Web.Common.PublishedModels;
@using Umbraco.Cms.Core.Models
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "GF_layout.cshtml";
}

<!-- page-title -->
<div class="ttm-page-title-row">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="title-box">
                    <div class="page-title-heading">
                        <h1 class="title">關於好饗初美味</h1>
                    </div>
                    <!-- /.page-title-captions -->
                    <div class="breadcrumb-wrapper">
                        <span>
                            <a title="Homepage" href="/">首頁</a>
                        </span>
                        <span class="ttm-bread-sep">
                            <i class="fa fa-angle-right" aria-hidden="true"></i>
                        </span>
                        <span><span>關於好饗初美味</span></span>
                    </div>
                </div>
            </div>
            <!-- /.col-md-12 -->
        </div>
        <!-- /.row -->
    </div>
    <!-- /.container -->
</div>
<!-- page-title END-->
<!--site-main start-->
<div class="site-main">
    <!-- story-section -->
    <section class="ttm-row story-section position-relative clearfix">
        <div class="container">
            <div class="row">
                <!-- row -->
                <div class="col-md-10 offset-md-1 col-lg-8 offset-lg-2">
                    <!-- section title -->
                    <div class="section-title text-center clearfix">
                        <div class="title-header">
                            <h4 style="color: #C5A572;"><b>@Model.Value("About_Subtitle")</b></h4>
                            <h2 class="title">@Model.Value("About_Title")</h2>
                        </div>
                        <div class="heading-seperator">
                            <span></span>
                        </div>
                    </div>
                    <!-- section title end -->
                </div>
            </div>
            <!-- row end-->
            <div class="row">
                <div class="col-md-10 offset-md-1 col-lg-8 offset-lg-2 text-center">
                    <h5>@Model.Value("About_Description")</h5>
                </div>
                <div class="col-md-12">
                    <div class="mt-20">
                        <!-- ttm_single_image-wrapper -->
                        <div class="ttm_single_image-wrapper text-center">
                            @{
                                var About_Banner = Model.Value<MediaWithCrops>("About_Banner");
                                if (About_Banner != null)
                                {
                                    <img class="img-fluid" src="@About_Banner.MediaUrl()" alt="About_Banner" />
                                }
                            }
                        </div>
                        <!-- ttm_single_image-wrapper end -->
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- story-section -->
    <!-- history-section -->
    <section class="ttm-row history-section ttm-bgcolor-darkgrey bg-img18 clearfix">
        <div class="container">
            <div class="row no-gutters">
                <!-- row -->
                <div class="col-lg-5">
                    <!-- col-bg-img-three -->
                    <div class="ttm-bg col-bg-img-three ttm-col-bgimage-yes res-991-ptb-200">
                        <div class="ttm-col-wrapper-bg-layer ttm-bg-layer">
                            <div class="ttm-bg-layer-inner"></div>
                        </div>
                        @*<div class="layer-content">
                            <div class="ttm-video-icon ttm-center-video-icon ttm_prettyphoto">
                                <!-- ttm-video-icon -->
                                <a class="ttm-icon ttm-icon_element-background-color-white ttm-icon_element-size-md ttm-icon_element-style-round ttm_prettyphoto mb-0"
                                   href="https://www.youtube.com/watch?v=wyXnoeJoKLw">
                                    <i class="fa fa-play"></i>
                                </a>
                            </div>
                        </div>*@
                    </div>
                </div>
                <div class="col-lg-7">
                    <div class="spacing-7">
                        <!-- section title -->
                        <div class="section-title clearfix">
                            <div class="title-header mb-40">
                                <h5>Our Journey</h5>
                                <h2 class="title">Check Our History</h2>
                            </div>
                        </div>
                        <!-- section title end -->
                        <div id="ttm-timeline" class="clearfix">
                            <!--timeline-->
                            <div class="timeline">
                                <div class="timeline-panel">
                                    <!--timeline-panel-->
                                    <div class="timeline-date">
                                        <span class="timeline-year">2022</span><!--timeline-year-->
                                    </div>
                                    <div class="timeline-body">
                                        <!--timeline-body-->
                                        <h3 class="title">創新及突破自我階段</h3>
                                        <p class="h5">
                                            好饗初食品工廠設立
                                        </p>
                                    </div>
                                </div>
                                <div class="timeline-panel">
                                    <!--timeline-panel-->
                                    <div class="timeline-date">
                                        <span class="timeline-year">2021</span><!--timeline-year-->
                                    </div>
                                    <div class="timeline-body">
                                        <!--timeline-body-->
                                        <h3 class="title">運籌起步階段</h3>
                                        <p class="h5">
                                            確立目標，開始完整商品化產品及量化
                                        </p>
                                    </div>
                                </div>
                                <div class="timeline-panel">
                                    <!--timeline-panel-->
                                    <div class="timeline-date">
                                        <span class="timeline-year">2020</span><!--timeline-year-->
                                    </div>
                                    <div class="timeline-body">
                                        <!--timeline-body-->
                                        <h3 class="title">草創階段</h3>
                                        <p class="h5">
                                            成立商行與烘焙工作室，鎖定營運方向
                                        </p>
                                    </div>
                                </div>
                            </div>
                            <!--timeline-->
                        </div>
                    </div>
                </div>
            </div>
            <!-- row end -->
        </div>
    </section>
    <!-- history-section -->
    <!-- client-section -->
