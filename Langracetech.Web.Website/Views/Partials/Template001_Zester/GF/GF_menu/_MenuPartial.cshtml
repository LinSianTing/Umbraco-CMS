<!-- Image - Start -->
@using Umbraco.Cms.Core.Models
<!-- Image - End -->
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage

@{
    IPublishedContent settingsBasic = Umbraco.ContentSingleAtXPath("//settingsBasic") ?? Model;
}

<header id="masthead" class="header ttm-header-style-01">
    <!-- ttm-header-wrap -->
    <div class="ttm-header-wrap">
        <!-- ttm-stickable-header-w -->
        <div id="ttm-stickable-header-w" class="ttm-stickable-header-w ttm-bgcolor-darkgrey clearfix">
            <div id="site-header-menu" class="site-header-menu">
                <div class="site-header-menu-inner ttm-stickable-header">
                    <div class="container-fluid">
                        <!-- site-branding -->
                        <div class="site-branding">
                            <a class="home-link" href="/" title="首頁" rel="home">
                                @{
                                    MediaWithCrops Header_Logo = settingsBasic.Value<MediaWithCrops>("Header_Logo");
                                    if (Header_Logo != null)
                                    {
                                        <img id="logo-img" class="img-center" src="@Header_Logo.MediaUrl()" alt="Header_Logo">
                                    }
                                }
                            </a>
                        </div><!-- site-branding end -->
                        <!--site-navigation -->
                        <div id="site-navigation" class="site-navigation">
                            <!-- header-icons -->
                            <div class="">
                                 <div class="ttm-header-icon ttm-header-search-link">
                                    <div class="ttm-search-overlay">
                                        <div class="ttm-bg-layer"></div>
                                        <div class="ttm-icon-close"></div>
                                        <div class="ttm-search-outer">
                                            <div class="ttm-form-title">Hi, How Can We Help You?</div>
                                            <form method="get" class="ttm-site-searchform" action="#">
                                                <input type="search" class="field searchform-s" name="s" placeholder="Type Word Then Enter...">
                                                <button type="submit">
                                                    <i class="ti ti-search"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                             <div class="ttm-menu-toggle">
                                <input type="checkbox" id="menu-toggle-form" />
                                <label for="menu-toggle-form" class="ttm-menu-toggle-block">
                                    <span class="toggle-block toggle-blocks-1"></span>
                                    <span class="toggle-block toggle-blocks-2"></span>
                                    <span class="toggle-block toggle-blocks-3"></span>
                                </label>
                            </div>
                            <nav id="menu" class="menu">
                                <ul class="dropdown">
                                    <li class="active">
                                        <a href="/">首頁</a>
                                    </li>
                                    <li>
                                        <a href="/about">關於好饗初美味</a>
                                    </li>
                                    <li>
                                        <a href="/products">委託研發與生產</a>
                                    </li>
                                    <li>
                                        <a href="/new-arrivals">最新研發產品</a>
                                    </li>
                                    <li>
                                        <a href="/contact">企業詢價</a>
                                    </li>
                                    <li>
                                        <a href="/faq">常見問答</a>
                                    </li>
                                </ul>
                            </nav>
                        </div><!-- site-navigation end-->
                    </div>
                </div>
            </div>
        </div><!-- ttm-stickable-header-w end-->
    </div><!--ttm-header-wrap end -->
</header><!--header end-->
