@using Umbraco.Cms.Web.Common.PublishedModels;
@*@using Umbraco.Cms.Core.Models;*@
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    var basicSettings = Umbraco.ContentSingleAtXPath("//settings_Basic") ?? Model;
    Layout = "Template001_Zester.cshtml";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="keywords" content="@(Model != null ? (Model.Value("SEO_MetaKeywords") != null ? Html.Raw(String.Join(",", (string[])Model.Value("SEO_MetaKeywords"))) : "Golden Food") : "Golden Food")" />
    <meta name="description" content="@(Model != null ? (Model.Value("SEO_MetaDescription") != null ? (!string.IsNullOrEmpty(Convert.ToString(Model.Value("SEO_MetaDescription"))) ? Html.Raw(Model.Value("SEO_MetaDescription")):"Golden Food") : "Golden Food") : "Golden Food")" />
    <meta name="author" content="https://www.langracetech.com/" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1" />
    <title>@(Model != null ? (Model.Value("SEO_MetaTitle") != null ? (!string.IsNullOrEmpty(Convert.ToString(Model.Value("SEO_MetaTitle"))) ? Html.Raw(Model.Value("SEO_MetaTitle")) : "Golden Food") : "Golden Food") : "Golden Food")</title>

    <!-- favicon icon -->
    <link rel="shortcut icon" href="/tpl/zst_GF/images/favicon.png" />

    <!-- bootstrap -->
    <link rel="stylesheet" type="text/css" href="/tpl/zst_GF/css/bootstrap.min.css" />

    <!-- animate -->
    <link rel="stylesheet" type="text/css" href="/tpl/zst_GF/css/animate.css" />

    <link rel="stylesheet" type="text/css" href="/tpl/zst_GF/css/animate.min.css" />

    <!-- owl-carousel -->
    <link rel="stylesheet" type="text/css" href="/tpl/zst_GF/css/owl.carousel.css" />

    <!-- fontawesome-CDN -->
    <script src="https://kit.fontawesome.com/b677c2f0a5.js" crossorigin="anonymous"></script>

    <!-- themify -->
    <link rel="stylesheet" type="text/css" href="/tpl/zst_GF/css/themify-icons.css" />

    <!-- flaticon -->
    <link rel="stylesheet" type="text/css" href="/tpl/zst_GF/css/flaticon.css" />

    <!-- REVOLUTION LAYERS STYLES -->
    <link rel="stylesheet" type="text/css" href="/tpl/zst_GF/revolution/css/layers.css" />
    <link rel="stylesheet" type="text/css" href="/tpl/zst_GF/revolution/css/settings.css" />

    <!-- prettyphoto -->
    <link rel="stylesheet" type="text/css" href="/tpl/zst_GF/css/prettyPhoto.css" />

    <!-- shortcodes -->
    <link rel="stylesheet" type="text/css" href="/tpl/zst_GF/css/shortcodes.css" />

    <!-- main -->
    <link rel="stylesheet" type="text/css" href="/tpl/zst_GF/css/main.css" />

    <!-- responsive -->
    <link rel="stylesheet" type="text/css" href="/tpl/zst_GF/css/responsive.css" />
</head>

<body>
     <!-- Eric 驗證 Global Code - Start -->
     <div>
        <span>FB : @basicSettings.Value("Social_Media_Links_FB")</span>
        <span>Line : @basicSettings.Value("Social_Media_Links_Line")</span>
        <span>IG : @basicSettings.Value("Social_Media_Links_IG")</span>
        <span>Youtube : @basicSettings.Value("Social_Media_Links_YouTube")</span>
        <span>FB Chat : @basicSettings.Value("FB_Messenger_Chat_Plugin_Code")</span>
        <span>Footer Copyright : @basicSettings.Value("Footer_Copyright")</span>
        <span>Footer Title : @basicSettings.Value("Footer_Title")</span>
        <span>Footer Logo : @basicSettings.Value("Footer_Logo")</span>
     </div>
    <!-- Eric 驗證 Global Code - End -->

    <!-- FB - Messenger 洽談外掛程式 Code - Start -->

    <!-- FB - Messenger 洽談外掛程式 Code - End -->
    <!--page start-->
    <div class="page">

        <!--header start-->
        @await Html.PartialAsync("Template001_Zester/GF/GF_menu/_MenuPartial")
        <!--header end-->
        <!-- page-title -->
        <!-- page-title END-->
        <!--site-main start-->
        @RenderBody()
        <!--site-main end-->
        <!--footer start-->
        @await Html.PartialAsync("Template001_Zester/GF/GF_footer/_FooterPartial")
        <!--footer end-->
        <!--back-to-top start-->
        <a id="totop" href="#top">
            <i class="fa fa-angle-up"></i>
        </a>
        <!--back-to-top end-->
    </div>
    <!-- page end -->
    <!-- Javascript -->
    <script src="/tpl/zst_GF/js/jquery.min.js"></script>
    <script src="/tpl/zst_GF/js/tether.min.js"></script>
    <script src="/tpl/zst_GF/js/bootstrap.min.js"></script>
    <script src="/tpl/zst_GF/js/jquery.easing.js"></script>
    <script src="/tpl/zst_GF/js/jquery-waypoints.js"></script>
    <script src="/tpl/zst_GF/js/jquery-validate.js"></script>
    <script src="/tpl/zst_GF/js/owl.carousel.js"></script>
    <script src="/tpl/zst_GF/js/jquery.prettyPhoto.js"></script>
    <script src="/tpl/zst_GF/js/numinate.min.js?ver=4.9.3"></script>
    <script src="/tpl/zst_GF/js/main.js"></script>

    <!-- Revolution Slider -->
    <script src="/tpl/zst_GF/revolution/js/jquery.themepunch.tools.min.js"></script>
    <script src="/tpl/zst_GF/revolution/js/jquery.themepunch.revolution.min.js"></script>
    <script src="/tpl/zst_GF/revolution/js/slider.js"></script>

    <!-- SLIDER REVOLUTION 5.0 EXTENSIONS  (Load Extensions only on Local File Systems !  The following part can be removed on Server for On Demand Loading) -->
    <script src="/tpl/zst_GF/revolution/js/extensions/revolution.extension.actions.min.js"></script>
    <script src="/tpl/zst_GF/revolution/js/extensions/revolution.extension.carousel.min.js"></script>
    <script src="/tpl/zst_GF/revolution/js/extensions/revolution.extension.kenburn.min.js"></script>
    <script src="/tpl/zst_GF/revolution/js/extensions/revolution.extension.layeranimation.min.js"></script>
    <script src="/tpl/zst_GF/revolution/js/extensions/revolution.extension.migration.min.js"></script>
    <script src="/tpl/zst_GF/revolution/js/extensions/revolution.extension.navigation.min.js"></script>
    <script src="/tpl/zst_GF/revolution/js/extensions/revolution.extension.parallax.min.js"></script>
    <script src="/tpl/zst_GF/revolution/js/extensions/revolution.extension.slideanims.min.js"></script>
    <!-- Javascript end-->
</body>
</html>
