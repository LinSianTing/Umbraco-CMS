                                        {
                                            <img class="img-fluid" src="@About_ProductImage_05.MediaUrl()" alt="About_ProductImage_05" />
                                        }
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="client-box ttm-box-view-boxed-logo">
                            <div class="client">
                                <div class="ttm-client-logo-tooltip"
                                     data-tooltip="@Model.Value("About_ProductName_06")">
                                    @{
                                        var About_ProductImage_06 = Model.Value<MediaWithCrops>("About_ProductImage_06");
                                        if (About_ProductImage_06 != null)
                                        {
                                            <img class="img-fluid" src="@About_ProductImage_06.MediaUrl()" alt="About_ProductImage_06" />
                                        }
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="client-box ttm-box-view-boxed-logo">
                            <div class="client">
                                <div class="ttm-client-logo-tooltip"
                                     data-tooltip="@Model.Value("About_ProductName_07")">
                                    @{
                                        var About_ProductImage_07 = Model.Value<MediaWithCrops>("About_ProductImage_07");
                                        if (About_ProductImage_07 != null)
                                        {
                                            <img class="img-fluid" src="@About_ProductImage_07.MediaUrl()" alt="About_ProductImage_07" />
                                        }
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="client-box ttm-box-view-boxed-logo">
                            <div class="client">
                                <div class="ttm-client-logo-tooltip"
                                     data-tooltip="@Model.Value("About_ProductName_08")">
                                    @{
                                        var About_ProductImage_08 = Model.Value<MediaWithCrops>("About_ProductImage_08");
                                        if (About_ProductImage_08 != null)
                                        {
                                            <img class="img-fluid" src="@About_ProductImage_08.MediaUrl()" alt="About_ProductImage_08" />
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- ttm-client end -->
                </div>
            </div>
        </div>
    </div>
    <!-- client-section end-->
    <!-- team-member-section -->
    <section class="ttm-row last-section clearfix">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-9 col-xl-10 col-md-9">
                    <!-- section-title -->
                    <div class="section-title style2 clearfix">
                        <div class="title-header">
                            <h4 style="color: #C5A572;"><b>@Model.Value("Team_Subtitle")</b></h4>
                            <h2 class="title">@Model.Value("Team_Title")</h2>
                        </div>
                        <div class="title-desc">
                            <h5><b>@Model.Value("Team_Description")</b></h5>
                        </div>
                    </div>
                    <!-- section-title end -->
                </div>
            </div>
            <!-- row -->
            <div class="row">
                <div class="team-slide owl-carousel"
                     data-item="3"
                     data-nav="false"
                     data-dots="false"
                     data-auto="true">
                    <!-- featured-imagebox-team -->
                    <div class="featured-imagebox featured-imagebox-team style1">
                        <!-- featured-thumbnail -->
                        <div class="featured-thumbnail">
                            @{
                                var Chef_01_Image = Model.Value<MediaWithCrops>("Chef_01_Image");
                                if (Chef_01_Image != null)
                                {
                                    <img class="img-fluid" src="@Chef_01_Image.MediaUrl()" alt="Chef_01_Image" />
                                }
                            }
                            <!-- team-member-img -->
                            <div class="ttm-social-links-wrapper">
                                <!-- team-member-social-link -->
                                <ul class="social-icons circle list-inline">
                                    <li class="social-facebook">
                                        <a href="@Model.Value("Chef_01_FB")" target="_blank">
                                            <i class="fa fa-facebook" aria-hidden="true"></i>
                                        </a>
                                    </li>
                                    <li class="social-instagram">
                                        <a href="@Model.Value("Chef_01_IG")" target="_blank">
                                            <i class="fa fa-instagram" aria-hidden="true"></i>
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                        <!-- featured-thumbnail end-->
                        <div class="featured-content text-center">
                            <!-- featured-content-->
                            <div class="featured-title">
                                <!-- team-member-name -->
                                <h5>@Model.Value("Chef_01_Name")</h5>
                            </div>
                            <div class="category">
                                <!-- team-member-category -->
                                <p class="mb-0"><b>@Model.Value("Chef_01_Title")</b></p>
                            </div>
                        </div>
                        <!-- featured-content end-->
                    </div>
                    <!-- featured-imagebox-team end -->
                    <!-- featured-imagebox-team -->
                    <div class="featured-imagebox featured-imagebox-team style1">
                        <!-- featured-thumbnail -->
                        <div class="featured-thumbnail">
                            @{
                                var Chef_02_Image = Model.Value<MediaWithCrops>("Chef_02_Image");
                                if (Chef_02_Image != null)
                                {
                                    <img class="img-fluid" src="@Chef_02_Image.MediaUrl()" alt="Chef_02_Image" />
                                }
                            }
                            <!-- team-member-img -->
                            <div class="ttm-social-links-wrapper">
                                <!-- team-member-social-link -->
                                <ul class="social-icons circle list-inline">
                                    <li class="social-instagram">
                                        <a href="mailto:@Model.Value("Chef_02_Email")" target="_blank">
                                            <i class="fa fa-envelope" aria-hidden="true"></i>
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                        <!-- featured-thumbnail end-->
                        <div class="featured-content text-center">
                            <!-- featured-content-->
                            <div class="featured-title">
                                <!-- team-member-name -->
                                <h5>@Model.Value("Chef_02_Name")</h5>
                            </div>
                            <div class="category">
                                <!-- team-member-category -->
                                <p class="mb-0"><b>@Model.Value("Chef_02_Title")</b></p>
                            </div>
                        </div>
                        <!-- featured-content end-->
                    </div>
                    <!-- featured-imagebox-team end -->
                </div>
            </div>
        </div>
    </section>
    <!-- team-member-section end -->
    <!-- certificate-section -->
    <section class="ttm-row last-section ttm-bgcolor-darkgrey bg-img18 clearfix">
        <div class="container">
            <div class="row">
                <div class="col-md-6 col-sm-12">
                    @{
                        var Certificate_Chef_01_Image = Model.Value<MediaWithCrops>("Certificate_Chef_01_Image");
                        if (Certificate_Chef_01_Image != null)
                        {
                            <img class="img-thumbnail img-fluid" src="@Certificate_Chef_01_Image.MediaUrl()" style="height: ;" alt="Certificate_Chef_01_Image">
                        }
                    }
                </div>

                <div class="col-md-6 col-sm-12">
                    @{
                        var Certificate_Chef_02_Image = Model.Value<MediaWithCrops>("Certificate_Chef_02_Image");
                        if (Certificate_Chef_02_Image != null)
                        {
                            <img class="img-thumbnail img-fluid" src="@Certificate_Chef_02_Image.MediaUrl()" style="height: ;" alt="Certificate_Chef_02_Image">
                        }
