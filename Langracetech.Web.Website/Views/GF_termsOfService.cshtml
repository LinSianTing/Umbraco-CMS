@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "GF_layout.cshtml";
}

<!-- page-title -->
<div class="ttm-page-title-row">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="title-box">
                    <div class="page-title-heading">
                        <h1 class="title">服務條款</h1>
                    </div><!-- /.page-title-captions -->
                    <div class="breadcrumb-wrapper">
                        <span>
                            <a title="Homepage" href="/">首頁</a>
                        </span>
                        <span class="ttm-bread-sep"><i class="fa fa-angle-right" aria-hidden="true"></i></span>
                        <span><span>服務條款</span></span>
                    </div>
                </div>
            </div><!-- /.col-md-12 -->
        </div><!-- /.row -->
    </div><!-- /.container -->
</div>
<!-- page-title END-->
<!--site-main start-->
<div class="site-main">
    <!-- menu-tab-section -->
    <section class="ttm-row only-one-section clearfix">
        <div class="container">
            <div class="row">
                <div class="col-md-12 col-sm-12">
                    <h5>@Model.Value("termsOfService")</h5>
                </div>
            </div><!-- row end-->
        </div>
    </section>
    <!-- menu-tab-section -->
</div>
<!--site-main end-->
