@using Umbraco.Cms.Web.Common.PublishedModels;
<!-- Image - Start -->
@using Umbraco.Cms.Core.Models;
<!-- Images - End -->
<!-- Tags - End -->
@using Umbraco.Cms.Core.PublishedCache;
@inject ITagQuery _tagQuery;
<!-- Tags - End -->
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "GF_layout.cshtml";
}
@{

    List<Umbraco.Cms.Core.Models.TagModel> allTags = _tagQuery.GetAllTags() as System.Collections.Generic.List<Umbraco.Cms.Core.Models.TagModel>;

    List<Umbraco.Cms.Core.Models.PublishedContent.IPublishedContent> Products = Umbraco.Content(Guid.Parse("58c58cc4-65cd-4f86-bfcc-6f5f07612aed")).Children().Where(x => x.IsVisible()).OrderBy(x => x.CreateDate).ToList();

    Dictionary<string, List<Umbraco.Cms.Core.Models.PublishedContent.IPublishedContent>> tagDictionaryAboutProduct = new Dictionary<string, List<IPublishedContent>>();
}

<!-- page-title -->
<div class="ttm-page-title-row">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="title-box">
                    <div class="page-title-heading">
                        <h1 class="title"><!--Gallery-->委託研發與生產</h1>
                    </div>
                    <!-- /.page-title-captions -->
                    <div class="breadcrumb-wrapper">
                        <span>
                            <a title="Homepage" href="/">首頁</a>
                        </span>
                        <span class="ttm-bread-sep">
                            <i class="fa fa-angle-right" aria-hidden="true"></i>
                        </span>
                        <span><span><!--Gallery 1-->委託研發與生產</span></span>
                    </div>
                </div>
            </div>
            <!-- /.col-md-12 -->
        </div>
        <!-- /.row -->
    </div>
    <!-- /.container -->
</div>
<!-- page-title END-->
<!--site-main start-->
<div class="site-main">
    <!-- menu-tab-section -->
    <section class="ttm-row only-one-section clearfix">
        <div class="container">
            <div class="row">
                <!-- row -->
                <div class="col-lg-12">
                    <div class="ttm-tabs ttm-tab-style-classic style3">

                        <!-- Tab - Start  -->
                        <ul class="tabs mb-0 w-100 justify-content-center">
                            @{
                                if (allTags != null)
                                {
                                    foreach (TagModel tag in allTags)
                                    {
                                        <!-- Step 1：呈現 Tag -->
                                        <li class="tab">
                                            <a href="#" data-tag="@tag.Text"><span>@tag.Text</span></a>
                                        </li>

                                        <!-- Step 1：滾 Tag 同時，透過 Dictionary 分籃整理 By Tag -->
                                        tagDictionaryAboutProduct.Add(string.IsNullOrEmpty(tag.Text) ? "null-" + tagDictionaryAboutProduct.Count : tag.Text, new List<IPublishedContent>());
                                    }
                                }
                            }
                        </ul>
                        <!-- Tab - End -->

                        <div class="content-tab w-100 ttm-bgcolor-white">
                            <!-- content-tab -->
                            <!-- Step 2：先滾出全部商品，放入第一個 content-inner -->
                            <!-- content-inner -->
                            <!-- Foreach Products -->
                            <div class="content-inner active" data-tag="all">
                                <div class="row">
                                    @foreach (var item in Products)
                                    {
                                        // Image
                                        IPublishedContent Products_Items_ProductImage = item.Value<IPublishedContent>("Products_Items_ProductImage");
                                        // Tags
                                        string[] allTagAboutThisProductsItem = item.Value("Tags") as string[];

                                        <!-- row -->
                                        <div class="col-md-4 col-sm-6">
                                            <!-- featured-imagebox-event -->
                                            <div class="featured-imagebox featured-imagebox-gallery style2">
                                                <div class="featured-imagebox-gallery-inner">
                                                    <div class="featured-thumbnail">
                                                        <!-- featured-thumbnail-->
                                                        <img class="img-fluid" src="@(Products_Items_ProductImage != null? Products_Items_ProductImage.Url(): String.Empty)" alt="Products_Items_ProductImage">
                                                    </div>
                                                    <!-- featured-thumbnail END-->
                                                    <div class="ttm-box-view-overlay">
                                                        <!-- ttm-box-view-overlay -->
                                                        <div class="ttm-media-link">
                                                            <!-- ttm-media-link-->
                                                            <a class="ttm_prettyphoto ttm_image"
                                                           data-gal="prettyPhoto[gallery1]"
                                                           title="@item.Value("Products_Items_ProductName")"
                                                           href="@(Products_Items_ProductImage != null? Products_Items_ProductImage.Url(): String.Empty)"
                                                           data-rel="Products_Items_ProductImage">
                                                                <i class="ti ti-search"></i>
                                                            </a>
                                                        </div>
                                                    </div>
                                                    <!-- ttm-box-view-overlay end-->
                                                </div>
                                                <div class="featured-content box-shadow">
                                                    <!-- featured-content-->
                                                    <div class="featured-title">
                                                        <!-- featured-title-->
                                                        <h5>@item.Value("Products_Items_ProductName")</h5>
                                                    </div>
                                                </div>
                                            </div>
                                            <!-- featured-imagebox-event END -->
                                        </div>

                                        <!-- Step 3：滾 All Product 同時，分籃整理 -->
                                        if (allTagAboutThisProductsItem != null)
                                        {
                                            foreach (string tagString in allTagAboutThisProductsItem)
                                            {
                                                tagDictionaryAboutProduct[tagString].Add(item);
                                            }
                                        }
                                    }
                                </div>
                                <!-- row end -->
                            </div>

                            <!-- Step 2：依照每個 Tag 滾出各自 content-inner , 並把屬於他 Tag 的 Product 放進去裡面 -->
                            @{
                                if (allTags != null)
                                {
                                    foreach (TagModel tag in allTags)
                                    {
                                        if (!String.IsNullOrEmpty(tag.Text))
                                        {
                                            <!-- content-inner -->
                                            <!-- 各 Tag Div -->
                                            <div class="content-inner" data-tag="@tag.Text" style="display:none;">
                                                <div class="row">
                                                    <!-- row -->
                                                    <!-- Step 3：每個 Product 重新滾一次，找有沒有媒合的 Tag, 判斷後呈現 -->
                                                    @foreach (IPublishedContent item in tagDictionaryAboutProduct[tag.Text])
                                                    {
                                                        // Image
                                                        IPublishedContent Products_Items_ProductImage = item.Value<IPublishedContent>("Products_Items_ProductImage");
                                                        // Tags
                                                        string[] allTagAboutThisProductsItem = item.Value("Tags") as string[];

                                                        <!-- row -->
                                                        <div class="col-md-4 col-sm-6">
                                                            <!-- featured-imagebox-event -->
                                                            <div class="featured-imagebox featured-imagebox-gallery style2">
                                                                <div class="featured-imagebox-gallery-inner">
                                                                    <div class="featured-thumbnail">
                                                                        <!-- featured-thumbnail -->
                                                                        <img class="img-fluid" src="@(Products_Items_ProductImage != null? Products_Items_ProductImage.Url(): String.Empty)" alt="Products_Items_ProductImage" />
                                                                    </div>
                                                                    <!-- featured-thumbnail END-->
                                                                    <div class="ttm-box-view-overlay">
                                                                        <!-- ttm-box-view-overlay -->
                                                                        <div class="ttm-media-link">
                                                                            <!-- ttm-media-link -->
                                                                            <a class="ttm_prettyphoto ttm_image"
                                                               data-gal="prettyPhoto[gallery1]"
                                                               title="@item.Value("Products_Items_ProductName")"
                                                               href="@(Products_Items_ProductImage != null? Products_Items_ProductImage.Url(): String.Empty)"
                                                               data-rel="Products_Items_ProductImage">
                                                                                <i class="ti ti-search"></i>
                                                                            </a>
                                                                        </div>
                                                                    </div>
                                                                    <!-- ttm-box-view-overlay end-->
                                                                </div>
                                                                <div class="featured-content box-shadow">
                                                                    <!-- featured-content-->
                                                                    <div class="featured-title">
                                                                        <!-- featured-title-->
                                                                        <h5>@item.Value("Products_Items_ProductName")</h5>
                                                                        @if (allTagAboutThisProductsItem != null)
                                                                        {
                                                                            //<p>@String.Join(" ",allTagAboutThisProductsItem)</p>
                                                                        }
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <!-- featured-imagebox-event END -->
                                                        </div>
                                                    }
                                                </div>
                                                <!-- row end -->
                                            </div>
                                            <!-- content-inner -->
                                        }
                                    }
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
            <!-- row end-->
        </div>
    </section>
    <!-- menu-tab-section -->
</div>
<!--site-main end-->
