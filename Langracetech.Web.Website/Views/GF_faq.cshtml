@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "GF_layout.cshtml";
}

<!-- page-title -->
<div class="ttm-page-title-row">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="title-box">
                    <div class="page-title-heading">
                        <h1 class="title">常見問答</h1>
                    </div>
                    <!-- /.page-title-captions -->
                    <div class="breadcrumb-wrapper">
                        <span>
                            <a title="Homepage" href="/">首頁</a>
                        </span>
                        <span class="ttm-bread-sep">
                            <i class="fa fa-angle-right" aria-hidden="true"></i>
                        </span>
                        <span><span>常見問答</span></span>
                    </div>
                </div>
            </div>
            <!-- /.col-md-12 -->
        </div>
        <!-- /.row -->
    </div>
    <!-- /.container -->
</div>
<!-- page-title END-->
<!--site-main start-->
<div class="site-main">
    <!-- faq-section -->
    <section class="ttm-row only-one-section ttm-bgcolor-grey clearfix">
        <div class="container">
            <div class="row">
                <!-- row -->
                <div class="col-md-10 offset-md-1 col-lg-6 offset-lg-3">
                    <!-- section title -->
                    <div class="section-title text-center clearfix">
                        <div class="title-header mb-65">
                            <h4 style="color:#C5A572"><b>@Model.Value("subtitle")</b></h4>
                            <h2 class="title">@Model.Value("title")</h2>
                        </div>
                        <div class="heading-seperator">
                            <span></span>
                        </div>
                    </div>
                    <!-- section title end -->
                    <p class="text-center">
                        @Model.Value("Description")
                    </p>
                </div>
            </div>
            <!-- row end-->
            <div class="row mt-40">
                <!-- row -->
                <div class="col-lg-12">
                    <!-- accordion -->
                    <div class="accordion">
                        @{
                            var faqs = Umbraco.Content(Guid.Parse("acdb4823-80d9-4489-bce2-5d374ce1af4c"))
                            .Children()
                            .Where(x => x.IsVisible())
                            .OrderBy(x => x.CreateDate);
                        }

                        @foreach (var item in faqs)
                        {
                            <div class="toggle">
                                <!-- toggle-->
                                <div class="toggle-title">
                                    <!-- toggle-title  -->
                                    <a data-toggle="collapse"
                                   data-parent="#accordion"
                                   href="#collapseThree">@item.Value("FAQ_Question")</a>
                                </div>
                                <div class="toggle-content">
                                    <!-- toggle-content -->
                                    <h5>@item.Value("FAQ_Answer")</h5>
                                </div>
                            </div>
                            <!-- toggle end -->
                        }
                        <!-- toggle end -->
                    </div>
                    <!-- accordion end-->
                </div>
            </div>
            <!-- row end-->
        </div>
    </section>
    <!-- faq-section -->
</div>
<!--site-main end-->
