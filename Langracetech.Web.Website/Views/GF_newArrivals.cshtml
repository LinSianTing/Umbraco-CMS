@using Umbraco.Cms.Web.Common.PublishedModels;
<!-- Image - Start -->
@using Umbraco.Cms.Core.Models;
<!-- Images - End -->
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage

@{
    Layout = "GF_layout.cshtml";
}

<!-- page-title -->
<div class="ttm-page-title-row">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="title-box">
                    <div class="page-title-heading">
                        <h1 class="title">最新研發商品</h1>
                    </div><!-- /.page-title-captions -->
                    <div class="breadcrumb-wrapper">
                        <span>
                            <a title="Homepage" href="/">首頁</a>
                        </span>
                        <span class="ttm-bread-sep"><i class="fa fa-angle-right" aria-hidden="true"></i></span>
                        <span><span>最新研發商品</span></span>
                    </div>
                </div>
            </div><!-- /.col-md-12 -->
        </div><!-- /.row -->
    </div><!-- /.container -->
</div>
<!-- page-title END-->
<!--site-main start-->
<div class="site-main">
    <!-- menu-tab-section -->
    <section class="ttm-row only-one-section clearfix">
        <div class="container">
            <div class="row">
                <!-- row -->
                @{
                    var New_Arrivals = Umbraco.Content(Guid.Parse("81c6cd9d-3381-4c5f-a11d-4e0ad6429de0"))
                    .Children()
                    .Where(x => x.IsVisible())
                    .OrderBy(x => x.CreateDate);
                }

                @foreach (var item in New_Arrivals)
                {
                    // Image
                    var NewArrivals_Items_ProductImage = item.Value<IPublishedContent>("NewArrivals_Items_ProductImage");

                    <div class="col-md-4 col-sm-6">
                        <!-- featured-imagebox-event -->
                        <div class="featured-imagebox featured-imagebox-gallery style1 mb-30">
                            <div class="featured-thumbnail">
                                <!-- featured-thumbnail-->
                                <img class="img-fluid" src="@(NewArrivals_Items_ProductImage != null? NewArrivals_Items_ProductImage.Url(): String.Empty)" alt="NewArrivals_Items_ProductImage">
                            </div>
                            <div class="ttm-box-view-overlay">
                                <!-- ttm-box-view-overlay -->
                                <div class="ttm-media-link">
                                    <!-- ttm-media-link-->
                                    <a class="ttm_prettyphoto ttm_image" data-gal="prettyPhoto[gallery1]" title="@item.Value("NewArrivals_Items_ProductName")" href="@(NewArrivals_Items_ProductImage != null? NewArrivals_Items_ProductImage.Url(): String.Empty)" data-rel="NewArrivals_Items_ProductImage">
                                        <i class="ti ti-search"></i>
                                    </a>
                                </div>
                                <div class="featured-content">
                                    <!-- featured-content-->
                                    <div class="featured-title">
                                        <!-- featured-title-->
                                        <h5>@item.Value("NewArrivals_Items_ProductName")</h5>
                                    </div>
                                </div>
                            </div><!-- ttm-box-view-overlay end-->
                        </div><!-- featured-imagebox-event END -->
                    </div>
                }
            </div><!-- row end-->
        </div>
    </section>
    <!-- menu-tab-section -->
</div>
<!--site-main end-->
